{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":enableVulnerabilityAlerts"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch", "pin", "digest"], "automerge": true },
    { "matchDepTypes": ["devDependencies"], "automerge": true },
    { "matchManagers": ["github-actions"], "automerge": true },
    { "matchUpdateTypes": ["major"], "automerge": false }
  ]
}
